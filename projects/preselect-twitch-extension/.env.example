# Local unauthenticated demo only. Never enabled when NODE_ENV=production or on Vercel.
PICK_PREDICT_DEMO=false
PICK_PREDICT_PUBLIC_ORIGIN=http://localhost:4173
# Production must use an absolute path on a persistent volume, exactly one Node process.
PICK_PREDICT_DATA_FILE=

# Twitch Extension identity (not necessarily the standalone OAuth application ID).
TWITCH_EXTENSION_CLIENT_ID=
TWITCH_EXTENSION_SECRET=
# Optional restricted beta: numeric channel IDs separated by commas.
TWITCH_CHANNEL_IDS=

# Optional standalone producer/viewer Twitch OAuth.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=
# Supply a strong random session secret of at least 32 characters. No default exists.
SESSION_SECRET=
TWITCH_BROADCASTER_IDS=
# JSON mapping from moderator ID to explicitly allowed broadcaster channel IDs.
TWITCH_MODERATOR_CHANNELS={}

# Required only for the frontend ZIP build. Must match the reviewed backend origin.
PICK_PREDICT_EBS_ORIGIN=
