# Create .env.local and paste your PandaScore token here. Never expose this as NEXT_PUBLIC_*.
PANDASCORE_API_KEY=your_pandascore_token

# Canonical production origin used by metadata, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://homesports.vercel.app

# Passwordless account login. These two browser-safe values come from Supabase → Connect.
# Keep disabled until cookie-based SSR sessions, RLS, deletion, and export are deployed.
NEXT_PUBLIC_ENABLE_ACCOUNTS=false
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
